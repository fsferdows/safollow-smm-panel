{
  "name": "safollow-platform",
  "version": "3.0.0",
  "description": "SAFollow - Bangladesh SMM Panel & Reseller Platform V3.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node test.js && node test_extra.js",
    "mcp": "cd mcp_server && node dist/adapters/inbound/mcp/server.js",
    "mcp:gateway": "cd mcp_server && node dist/adapters/inbound/gateway.js",
    "mcp:build": "cd mcp_server && npm run build",
    "mcp:test": "cd mcp_server && npm test",
    "rust:build": "cd rust_engine && cargo build --release",
    "rust:gateway": "./rust_engine/target/release/universal-smm-gateway serve --port 3002"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
